{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caja",
  "version": "0.2.7",
  "identifier": "com.caja.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Caja",
        "width": 1280,
        "height": 832,
        "minWidth": 920,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "Dorabae",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5MDQ4MjU5QzMwNzY0QjEKUldTeFpBZkRXWUlFMmJhcDBBN083NUFNNHhPQUkwN1FIbmlKUjdOdG9jOVIzOTVGMDFFZW0vODUK",
      "endpoints": [
        "https://github.com/dorabaee/caja-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
